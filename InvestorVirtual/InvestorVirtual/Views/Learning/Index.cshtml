@model IEnumerable<LearningServiceModel>

@{
    ViewData["Title"] = "Learning";
}

<div class="container py-4 learning-container">
    <div class="mb-5 text-center">
        <h1 class="fw-bold">Learning</h1>
        <p class="text-secondary">Key terms and market concepts to help you navigate the stock market like a pro.</p>
        <div class="badge border border-secondary px-3 py-2 mb-3">
            <i class="bi bi-info-circle me-1"></i> More terms coming soon
        </div>

        <!-- + Add Term Action Button -->
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div>
                <a asp-action="Create" class="btn auth-btn-primary d-inline-flex align-items-center gap-2 px-4 py-2">
                    <img src="@Url.Content("~/images/icons/add.svg")" alt="Add" style="width: 16px; height: 16px; filter: brightness(0);" />
                    <span>Add New Learning Term</span>
                </a>
            </div>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
        @foreach (var term in Model)
        {
            <div class="col">
                <div class="card terminal-card border rounded-3 h-100 p-3">

                    <!-- Top Right Action Icons Container -->
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="position-absolute top-0 end-0 p-3 d-flex align-items-center gap-2">
                            <!-- Edit Button (Keeps theme settings via auth-btn-primary style) -->
                            <a asp-action="Edit" asp-route-id="@term.Id" asp-route-slug="@term.Slug" class="btn auth-btn-primary d-flex align-items-center justify-content-center p-2 rounded-2" style="width: 32px; height: 32px;" title="Edit Term">
                                <img src="@Url.Content("~/images/icons/edit.svg")" alt="Edit" style="width: 16px; height: 16px; filter: brightness(0);" />
                            </a>

                            <!-- Delete Button (Custom non-theme red styling) -->
                            <a asp-action="Delete" asp-route-id="@term.Id" asp-route-slug="@term.Slug" class="btn d-flex align-items-center justify-content-center p-2 rounded-2 text-white" style="width: 32px; height: 32px; background-color: #dc2626;" title="Delete Term" onmouseover="this.style.backgroundColor='#b91c1c'" onmouseout="this.style.backgroundColor='#dc2626'">
                                <img src="@Url.Content("~/images/icons/delete.svg")" alt="Delete" style="width: 16px; height: 16px; filter: brightness(0) invert(1);" />
                            </a>
                        </div>
                    }
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge bg-transparent border border-light rounded-2 mb-3 small">
                                @term.Category.GetDisplayName()
                            </span>
                            <h3 class="card-title h5 fw-semibold mb-3 glow-text">@term.TermName</h3>
                            <p class="card-text text-secondary small lh-base">@term.Description</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Learning terms navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link terminal-page-link rounded-3 px-3 py-2 me-1"
                       href="@Url.Action("Index", new { page = i })">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>