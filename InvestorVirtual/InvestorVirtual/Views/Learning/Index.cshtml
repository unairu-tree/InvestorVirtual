@model IEnumerable<LearningIndexViewModel>

@{
    ViewData["Title"] = "Learning";
}

<div class="container py-4">
    <div class="mb-5 text-center">
        <h1 class="text-white fw-bold">Learning</h1>
        <p class="text-secondary">Key terms and market concepts to help you navigate the stock market like a pro.</p>
        <div class="badge bg-dark border border-secondary text-light px-3 py-2">
            <i class="bi bi-info-circle me-1"></i> More terms coming soon
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
        @foreach (var term in Model)
        {
            <div class="col">
                <div class="card bg-black border border-secondary rounded-3 h-100 p-3">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge bg-transparent border border-light text-light rounded-2 mb-3 small">
                                @term.Category.GetDisplayName()
                            </span>
                            <h3 class="card-title text-white h5 fw-semibold mb-3">@term.TermName</h3>
                            <p class="card-text text-secondary small lh-base">@term.Description</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Learning terms navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item">
                <a class="page-link bg-black text-white border-secondary rounded-3 px-3 py-2 me-1" href="@Url.Action("Index", new { page = 1 })">1</a>
            </li>
            <li class="page-item">
                <a class="page-link bg-black text-white border-secondary rounded-3 px-3 py-2 me-1" href="@Url.Action("Index", new { page = 2 })">2</a>
            </li>
            <li class="page-item">
                <a class="page-link bg-black text-white border-secondary rounded-3 px-3 py-2" href="@Url.Action("Index", new { page = 3 })">3</a>
            </li>
        </ul>
    </nav>
</div>