@model LearningTermInputModel

@{
    ViewData["Title"] = "Create Learning Term";
}

<!-- Constrained container centered on the page -->
<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-10 col-lg-8">

        <!-- Header with explicitly styled visible description -->
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: var(--terminal-text);">Create Learning Term</h2>
            <p class="small mb-0" style="color: var(--terminal-text); opacity: 0.75;">Add a new financial term or concept to the learning library for users to explore.</p>
        </div>

        <!-- Form Card Container with a wider max-width override -->
        <div class="auth-card-muted p-4 p-md-5 rounded shadow-sm mx-auto" style="max-width: 680px; width: 100%;">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

                <!-- Term Name Field -->
                <div class="form-floating auth-group-muted mb-3">
                    <input asp-for="TermName" class="form-control auth-input-muted" id="TermNameInput" placeholder="The name of the term..." maxlength="100" autocomplete="off" required />
                    <label asp-for="TermName">Term Name</label>
                    <span asp-validation-for="TermName" class="text-danger small"></span>
                </div>

                <!-- Slug Field -->
                <div class="form-floating auth-group-muted mb-1">
                    <input asp-for="Slug" class="form-control auth-input-muted" id="SlugInput" placeholder="Example: name-of-term" maxlength="100" autocomplete="off" />
                    <label asp-for="Slug">URL Slug</label>
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>
                <!-- Fixed: Explicitly using terminal text variable for visibility -->
                <div class="small mb-4" style="color: var(--terminal-text); opacity: 0.75;">
                    <i class="bi bi-info-circle me-1"></i>
                    Optional: Auto-generated from name if left empty. Use lowercase letters, numbers, and hyphens only.
                </div>

                <!-- Description Field -->
                <div class="form-floating auth-group-muted mb-4">
                    <textarea asp-for="Description" class="form-control auth-input-muted" placeholder="The definition of what the term means..." style="height: 100px;" required></textarea>
                    <label asp-for="Description">Description</label>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Category Field -->
                <div class="form-floating auth-group-muted mb-3">
                    <select asp-for="CategoryId" class="form-select auth-input-muted" style="background-color: var(--terminal-card-bg); color: var(--terminal-text);">
                        <option value="" style="background-color: var(--terminal-card-bg); color: var(--terminal-text);">-- Select Category --</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id" style="background-color: var(--terminal-card-bg); color: var(--terminal-text);">@category.Name</option>
                        }
                    </select>
                    <label asp-for="CategoryId">Term Category</label>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex flex-column gap-2 mt-4">
                    <button type="submit" class="auth-btn-primary w-100 fw-semibold py-2">
                        <i class="bi bi-plus-lg me-1"></i> Create Term
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 text-decoration-none py-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_SlugGeneratorScriptPartial" />
}