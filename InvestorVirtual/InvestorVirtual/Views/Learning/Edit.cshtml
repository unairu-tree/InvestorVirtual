@model LearningTermInputModel

@{
    ViewData["Title"] = "Edit Learning Term";
}

<!-- Constrained container centered on the page -->
<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-10 col-lg-8">

        <!-- Header -->
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: var(--terminal-text);">Edit Learning Term</h2>
            <p class="small mb-0" style="color: var(--terminal-text); opacity: 0.75;">Modify the details of the selected financial term or concept.</p>
        </div>

        <!-- Form Card Container -->
        <div class="auth-card-muted p-4 p-md-5 rounded shadow-sm mx-auto" style="max-width: 680px; width: 100%;">
            <form method="post">

                <!-- Render shared form fields via partial -->
                <partial name="_LearningTermFormPartial" model="Model" />

                <!-- Action Buttons -->
                <div class="d-flex flex-column gap-2 mt-4">
                    <button type="submit" class="auth-btn-primary w-100 fw-semibold py-2">
                        <i class="bi bi-check-lg me-1"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 text-decoration-none py-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_SlugGeneratorScriptPartial" />
}