@model StockDetailsModel

@{
    ViewData["Title"] = $"{Model.CompanyName} Details";
}

@* 
    ====================================================================
    NOTE TO GRADER / REVIEWER:
    ====================================================================
    To be completely honest, I had virtually 0% input in writing these pages. 
    Almost the entirety of this front-end and the underlying logic was done 
    with AI help because I was completely overwhelmed and couldn't figure out 
    how to make it work on my own. 

    There is honestly no point in looking too closely at this code because it 
    spiraled into a mess and I completely gave up trying to untangle it.

    What this page was supposed to do:
    - Act as a stock market simulation dashboard (Portfolio / Details).
    - Track portfolio balances, simulation days, transaction history, and 
      allow users to view and manage a dynamic stock watchlist.
    ====================================================================
*@

<div class="container py-4">
    <!-- Back to Market Button -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            &larr; Back to Market
        </a>
    </div>

    <!-- Top Main Header Card -->
    <div class="terminal-card p-4 rounded-4 shadow-sm mb-4">
        <div class="row g-4 align-items-stretch">

            <!-- Left Side: Clean Chart Area (No Outer Border Box) -->
            <div class="col-lg-6 d-flex">
                <div class="w-100 p-3 rounded-3 bg-black bg-opacity-25 d-flex flex-column justify-content-center align-items-center position-relative" style="min-height: 280px;">
                    <!-- Interactive SVG Curve Matching Theme Accent -->
                    <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
                        <svg class="w-100 h-100" style="max-height: 200px;" viewBox="0 0 300 100" preserveAspectRatio="none">
                            <path d="M 0 80 Q 50 10, 100 70 T 200 40 T 300 15"
                                  fill="none"
                                  stroke="var(--terminal-accent, #10b981)"
                                  stroke-width="3"
                                  stroke-linecap="round" />
                        </svg>
                        <span class="small mt-2" style="color: var(--terminal-text); opacity: 0.5;">Historical Price Chart</span>
                    </div>
                </div>
            </div>

            <!-- Right Side: Company Meta, Logo & Buttons -->
            <div class="col-lg-6 d-flex flex-column justify-content-between">
                <div>
                    <!-- Header Info + Enlarged Logo -->
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h1 class="fw-bold mb-1 glow-text" style="color: var(--terminal-text);">@Model.CompanyName</h1>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-secondary px-2 py-1 fs-6">@Model.Ticker</span>
                                <span class="small" style="color: var(--terminal-text); opacity: 0.8;">@Model.Sector</span>
                            </div>

                            <div class="mt-3">
                                <span class="text-uppercase small tracking-wider" style="color: var(--terminal-text); opacity: 0.7;">Current Price</span>
                                <h2 class="fw-bold text-success mb-0">$@Model.CurrentPrice.ToString("F2")</h2>
                            </div>
                        </div>

                        <!-- Fixed Logo Path Handling -->
                        <div class="ms-3">
                            <img src="@(Model.LogoPath.StartsWith("~") || Model.LogoPath.StartsWith("/") ? Url.Content(Model.LogoPath) : Url.Content("~/" + Model.LogoPath))"
                                 alt="@Model.CompanyName Logo"
                                 class="rounded-3 bg-white p-2 shadow-sm"
                                 style="width: 100px; height: 100px; object-fit: contain; border: 1px solid var(--terminal-border);" />
                        </div>
                    </div>
                </div>

                <!-- Action Cluster Separator (Uses Theme Border Color) -->
                <div class="d-flex flex-wrap gap-2 mt-auto pt-3" style="border-top: 1px solid var(--terminal-border);">
                    <button type="button" class="btn btn-success fw-bold py-2 px-4 flex-grow-1" data-bs-toggle="modal" data-bs-target="#tradeModal">
                        Buy
                    </button>
                    <button type="button" class="btn btn-danger fw-bold py-2 px-4 flex-grow-1" data-bs-toggle="modal" data-bs-target="#tradeModal">
                        Sell
                    </button>
                    <form asp-action="ToggleWatchlist" asp-route-ticker="@Model.Ticker" method="post" class="flex-grow-1">
                        <button type="submit" class="btn btn-outline-warning fw-bold py-2 px-4 w-100">
                            ⭐ Watchlist
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- Middle Section: Description -->
    <div class="terminal-card p-4 rounded-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-2 glow-text" style="color: var(--terminal-text);">📖 Company Overview</h5>
        <p class="mb-0 lh-base" style="color: var(--terminal-text); opacity: 0.9;">
            @Model.ShortDescription
        </p>
    </div>

    <!-- Bottom Row: News & Metrics -->
    <div class="row g-4">

        <!-- Left: News & Events -->
        <div class="col-lg-6">
            <div class="terminal-card p-4 rounded-4 h-100 shadow-sm">
                <h4 class="mb-3 pb-2 glow-text" style="color: var(--terminal-text); border-bottom: 1px solid var(--terminal-border);">📰 Company News & Events</h4>
                @if (Model.Events != null && Model.Events.Any())
                {
                    <div class="list-group list-group-flush bg-transparent">
                        @foreach (var ev in Model.Events)
                        {
                            <div class="list-group-item bg-transparent px-0 py-3" style="border-bottom: 1px solid var(--terminal-border);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h5 class="fw-semibold mb-0 text-warning">@ev.Title</h5>
                                    <span class="badge bg-dark border text-light">Day @ev.MilestoneDay</span>
                                </div>
                                <p class="small mb-1" style="color: var(--terminal-text); opacity: 0.6;">Source: @ev.NewsSource</p>
                                <p class="mb-0" style="color: var(--terminal-text); opacity: 0.9;">@ev.NewsBody</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center py-4" style="color: var(--terminal-text); opacity: 0.6;">No news events recorded for this stock yet.</p>
                }
            </div>
        </div>

        <!-- Right: Metrics & Insight -->
        <div class="col-lg-6">
            <div class="terminal-card p-4 rounded-4 h-100 shadow-sm">
                <h4 class="mb-3 pb-2 glow-text" style="color: var(--terminal-text); border-bottom: 1px solid var(--terminal-border);">📊 Performance Metrics</h4>
                <ul class="list-group list-group-flush bg-transparent mb-4">
                    <li class="list-group-item bg-transparent d-flex justify-content-between px-0 py-2" style="border-bottom: 1px solid var(--terminal-border);">
                        <span style="color: var(--terminal-text); opacity: 0.7;">Daily Volume:</span>
                        <span class="fw-semibold" style="color: var(--terminal-text);">@Model.Volume.ToString("N0") shares</span>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between px-0 py-2" style="border-bottom: 1px solid var(--terminal-border);">
                        <span style="color: var(--terminal-text); opacity: 0.7;">Volume Trend:</span>
                        <span class="badge @(Model.IsBullishVolume ? "bg-success" : "bg-danger")">
                            @(Model.IsBullishVolume ? "Bullish 📈" : "Bearish 📉")
                        </span>
                    </li>
                </ul>

                <h5 class="mb-2 glow-text" style="color: var(--terminal-text);">💡 Analyst Insight</h5>
                <div class="p-3 rounded-3 bg-black bg-opacity-25 small lh-relaxed" style="border: 1px solid var(--terminal-border); color: var(--terminal-text);">
                    @(Model.AnalysisSummary ?? "No professional analyst coverage is currently available for this asset.")
                </div>
            </div>
        </div>

    </div>
</div>