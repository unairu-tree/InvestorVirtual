@{
    ViewData["Title"] = "Theme Preview Testbed";
}

<!-- THEME TESTING SINCE THIS VIEW HAS NOT BEEN IMPLEMENTED YET -->

<div class="container py-4">
    <h2 class="mb-4">Terminal Theme Preview & Validation</h2>

    <!-- THEME 1: VAULTED GOLD -->
    <div class="theme-test-container theme-vaulted-gold">
        <h4 class="text-warning mb-3">1. Vaulted Gold Theme</h4>
        <div class="row g-4 align-items-center">
            <!-- Left Box: Bright Gradient (Navbar style) -->
            <div class="col-md-5">
                <div class="theme-banner-box">
                    Navbar / Bright Gradient Sample
                </div>
            </div>
            <!-- Right Box: Muted Card with Mock Login Form -->
            <div class="col-md-7">
                <div class="auth-card-muted m-0 max-w-100">
                    <h3 class="auth-title-muted mb-3" style="font-size: 1.3rem;">Mock Auth Test</h3>
                    <div class="form-floating auth-group-muted mb-3">
                        <input type="email" class="form-control auth-input-muted" placeholder=" " value="user@terminal.com" />
                        <label>Email Address</label>
                    </div>
                    <div class="form-floating auth-group-muted mb-3">
                        <input type="password" class="form-control auth-input-muted" placeholder=" " value="password123" />
                        <label>Password</label>
                    </div>
                    <button type="button" class="w-100 btn auth-btn-primary mb-3">Action Button</button>
                    <div class="text-center">
                        <a href="#" class="auth-link-muted">Sample helper link text</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

