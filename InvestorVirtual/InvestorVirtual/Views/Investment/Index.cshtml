@model IEnumerable<AllAssetsModel>

@{
    ViewData["Title"] = "Market Assets";
}

<div class="container py-4">
    <div class="mb-5 text-center">
        <h1 class="fw-bold glow-text">Market Assets</h1>
        <p class="text-secondary">Explore available simulated equities and company sectors.</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- 2-Column Grid Matching Learning Layout -->
        <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
            @foreach (var asset in Model)
            {
                <div class="col">
                    <partial name="_AssetCardPartial" model="asset" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="card terminal-card border p-5 rounded-4 text-center">
            <div class="card-body">
                <h4 class="fw-bold mb-2 glow-text">No Assets Found</h4>
                <p class="text-secondary mb-0">The simulation ledger currently contains no active equities.</p>
            </div>
        </div>
    }
</div>