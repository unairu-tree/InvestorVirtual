@if (TempData["SuccessMessage"] != null)
{
    <div id="terminal-toast" class="terminal-toast success">
        <div class="toast-content">
            <span class="toast-icon">✓</span>
            <span class="toast-message">@TempData["SuccessMessage"]</span>
        </div>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="terminal-toast" class="terminal-toast error">
        <div class="toast-content">
            <span class="toast-icon">✕</span>
            <span class="toast-message">@TempData["ErrorMessage"]</span>
        </div>
    </div>
}

<style>
    .terminal-toast {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 1080;
        background-color: var(--terminal-card-bg);
        color: var(--terminal-text);
        border: 1px solid var(--terminal-border);
        border-radius: 8px;
        padding: 1rem 1.5rem;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.4);
        transform: translateY(100px);
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .terminal-toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        .terminal-toast.success {
            border-color: var(--terminal-accent);
            box-shadow: 0 0 15px var(--terminal-glow);
        }

        .terminal-toast.error {
            border-color: #ef4444;
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.25);
        }

    .toast-content {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: 'JetBrains Mono Variable', monospace;
        font-size: 0.95rem;
    }

    .terminal-toast.success .toast-icon {
        color: var(--terminal-accent);
        font-weight: bold;
    }

    .terminal-toast.error .toast-icon {
        color: #ef4444;
        font-weight: bold;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toast = document.getElementById("terminal-toast");
        if (toast) {
            // Slide in smoothly after load
            setTimeout(() => {
                toast.classList.add("show");
            }, 100);

            // Automatically slide out and remove after 4 seconds
            setTimeout(() => {
                toast.classList.remove("show");
                setTimeout(() => {
                    toast.remove();
                }, 400);
            }, 4000);
        }
    });
</script>