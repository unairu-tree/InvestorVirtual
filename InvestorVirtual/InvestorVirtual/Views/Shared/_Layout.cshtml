<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InvestorVirtual</title>

    <!-- Synchronous theme injector to prevent old stored theme flashing upon page load -->
    <script>
        (function () {
            const theme = localStorage.getItem("terminal-theme") || "theme-vaulted-gold";
            const mode = localStorage.getItem("terminal-mode") === "light" ? "light-mode" : "";
            document.documentElement.className = `${theme} ${mode}`.trim();
        })();
    </script>

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InvestorVirtual.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column" style="min-height: 100dvh;">
    <header style="min-height: 60px;">
        <nav class="navbar navbar-expand-sm navbar-financial-primary mb-3">
            <div class="container-fluid justify-content-between align-items-center">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <a class="navbar-brand fw-bold position-absolute start-50 translate-middle-x" asp-area="" asp-controller="Home" asp-action="Index">InvestorVirtual</a>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between w-100">
                    <div class="navbar-nav">
                        <partial name="_NavMenuPartial" />
                    </div>
                    <div class="navbar-nav ms-auto">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <partial name="_FooterPartial" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>