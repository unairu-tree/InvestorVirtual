@{
    ViewData["Title"] = "About InvestorVirtual";
}

<div class="container py-5">
    <!-- Header Banner Card -->
    <div class="welcome-banner p-5 rounded-4 mb-4 text-center">
        <h1 class="display-5 fw-bold mb-3 glow-text">About InvestorVirtual</h1>
        <p class="lead mb-0 opacity-85">
            A professional-grade financial simulation platform engineered to bridge theoretical market mechanics with hands-on practice.
        </p>
    </div>

    <!-- Core Pillars Grid -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card terminal-card h-100 border p-4 rounded-4 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 fw-bold mb-3 glow-text">Ledger-Based Integrity</h3>
                    <p class="card-text text-secondary mb-0">
                        Holdings and portfolio values are dynamically derived from a robust transaction history log, ensuring absolute mathematical accuracy and single-source-of-truth reliability.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card terminal-card h-100 border p-4 rounded-4 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 fw-bold mb-3 glow-text">Milestone Simulations</h3>
                    <p class="card-text text-secondary mb-0">
                        Step through dynamic market cycles driven by automated milestone triggers, allowing you to test trading strategies against changing trends without real-world risk.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card terminal-card h-100 border p-4 rounded-4 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 fw-bold mb-3 glow-text">Dynamic Architecture</h3>
                    <p class="card-text text-secondary mb-0">
                        Built with clean multi-layered principles in ASP.NET Core and Entity Framework Core, optimized for performance, scalability, and seamless user experiences.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Call to Action Section -->
    <div class="card terminal-card border p-4 rounded-4 text-center">
        <div class="card-body py-3">
            <h4 class="fw-bold mb-2 glow-text">Ready to test your market strategies?</h4>
            <p class="text-secondary mb-4">Jump straight into your dashboard or explore the learning terms to sharpen your financial edge.</p>
            <a asp-controller="Home" asp-action="Index" class="btn auth-btn-primary px-4 py-2">Return to Dashboard</a>
        </div>
    </div>
</div>