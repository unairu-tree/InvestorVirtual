@model IEnumerable<AssetShowcaseModel>

@{
    ViewData["Title"] = "Home Page";
}

<div class="row justify-content-center my-4">
    <!-- Welcome Banner (Keeps its focused, clean width) -->
    <div class="col-12 col-md-10 col-lg-8">
        <div class="welcome-banner rounded-4 p-5 text-center mb-5">
            <h1 class="fw-bold mb-3">Welcome to Investor Virtual</h1>

            <!-- Dynamic Subtitle Text Container -->
            <p id="hero-subtitle" class="fs-5 mb-0 subtitle-fade-text">
                A professional-grade financial simulation platform and portfolio sandbox.
            </p>

            <div class="mt-4 d-flex justify-content-center gap-3">
                <!-- Action buttons wrapper -->
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Asset Ticker Marquee Section (Wider than the welcome banner) -->
        <div class="col-12 col-md-11 col-lg-10 px-0">
            <div class="asset-ticker-wrapper mb-4">
                <div class="asset-ticker-track">
                    <!-- First Set of Assets -->
                    @foreach (var asset in Model)
                    {
                        <div class="card terminal-card asset-ticker-card shadow-sm">
                            <img src="@Url.Content(asset.LogoPath)" alt="@asset.Ticker Logo" />
                            <span>@asset.Ticker</span>
                        </div>
                    }
                    <!-- Duplicate Set for Seamless Infinite Loop -->
                    @foreach (var asset in Model)
                    {
                        <div class="card terminal-card asset-ticker-card shadow-sm" aria-hidden="true">
                            <img src="@Url.Content(asset.LogoPath)" alt="@asset.Ticker Logo" />
                            <span>@asset.Ticker</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const subtitles = [
                "A professional-grade financial simulation platform and portfolio sandbox.",
                "Ledger-driven portfolio simulation and market strategy testing.",
                "Test your trading strategies and master portfolio mechanics in a simulated environment.",
                "Simulated portfolio management and historical market mechanics."
            ];

            let currentIndex = 0;
            const subtitleElement = document.getElementById("hero-subtitle");

            if (!subtitleElement) return;

            // Interval in milliseconds (3 minutes = 180,000ms; set shorter for testing e.g., 6000ms)
            const CHANGE_INTERVAL = 180000;

            setInterval(() => {
                // Step 1: Fade Out
                subtitleElement.classList.add("fade-out");

                setTimeout(() => {
                    // Step 2: Swap Text
                    currentIndex = (currentIndex + 1) % subtitles.length;
                    subtitleElement.textContent = subtitles[currentIndex];

                    // Step 3: Fade In
                    subtitleElement.classList.remove("fade-out");
                }, 800); // Matches the 0.8s CSS transition time
            }, CHANGE_INTERVAL);
        });
    </script>
}